# ==============================================================================
# NagarSeva Environment Configuration
# Copy this file to .env or .env.local to customize your local configuration
# ==============================================================================

# Database Configuration
# Default: Local SQLite file via LibSQL (pure JS/WASM compatible, zero setup required)
DATABASE_URL="file:local.db"

# Optional: Turso / Remote LibSQL authentication token (leave blank for local file SQLite)
# DATABASE_AUTH_TOKEN=""

# Security & Authentication
# Secret key used for HMAC-SHA256 JWT session tokens (provide a secure random string in production)
JWT_SECRET="nagarseva-default-dev-secret-key-change-in-production-123456"

# Server Port (optional, defaults to 5173 for dev, 3000 for preview/production)
PORT=5173

# Application Environment
NODE_ENV="development"
